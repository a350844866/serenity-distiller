# X (Twitter) session cookie — grab from browser DevTools:
# F12 → Application → Cookies → x.com → auth_token
XACTIONS_SESSION_COOKIE=your_auth_token_here

# Telegram bot for push notifications (optional)
TG_BOT_TOKEN=123456:ABC-DEF
TG_CHAT_ID=your_chat_id

# Paths (defaults work if you clone to the standard location)
# SYNC_DIR=/path/to/serenity-distiller
# DATA_DIR=/path/to/x-exports
# VAULT_DIR=/path/to/your/obsidian/vault
