# ---- LLM Provider ----
# Choose: anthropic | openai (also works with any OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Override model (defaults: claude-sonnet-4-20250514 / gpt-4o)
# LLM_MODEL=claude-sonnet-4-20250514

# For OpenAI-compatible endpoints (vLLM, Together, Groq, local Ollama, etc.)
# LLM_BASE_URL=http://localhost:11434/v1/chat/completions

# ---- Worker Mode ----
# api   — (default) direct LLM API call, zero CLI dependency
# tmux  — Claude Code CLI in tmux (legacy, requires Max sub + CLI)
WORKER_MODE=api

# ---- X (Twitter) ----
# Grab from browser DevTools: F12 → Application → Cookies → x.com → auth_token
XACTIONS_SESSION_COOKIE=your_auth_token_here

# ---- Telegram (optional) ----
TG_BOT_TOKEN=123456:ABC-DEF
TG_CHAT_ID=your_chat_id

# ---- Paths ----
# SYNC_DIR=/path/to/serenity-distiller
DATA_DIR=/path/to/x-exports
# VAULT_DIR=/path/to/your/obsidian/vault  (required for tmux mode & weekly snapshots)
